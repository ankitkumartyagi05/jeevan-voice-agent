# JEEVAN Core Protocol - Environment Configuration Template

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
JEEVAN_DEBUG=false
JEEVAN_GRAPHICS_QUALITY=high
JEEVAN_INTERRUPT_SENSITIVITY=balanced

# Gmail OAuth Credentials (Desktop App OAuth client)
GMAIL_CLIENT_SECRET_PATH=credentials.json

# Web Server Port
PORT=8080
